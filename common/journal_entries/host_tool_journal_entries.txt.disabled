je_host_tool = {
	icon = "gfx/interface/icons/notification_icons/diplomatic_play.dds"

	group = je_group_internal_affairs

	immediate = {
		set_variable = host_tool_current_host
		host_tool_refresh_runtime_lists = yes
	}

	on_complete = {
	}

	on_fail = {
	}

	invalid = {
		NOT = { has_variable = host_tool_current_host }
	}

	on_invalid = {
	}

	status_desc = {
		first_valid = {
			triggered_desc = {
				desc = host_tool_status_active
				trigger = {
					has_variable = host_tool_current_host
				}
			}
		}
	}

	on_monthly_pulse = {
		effect = {
			host_tool_refresh_runtime_lists = yes
		}
	}

	weight = 10000
	transferable = no
	can_revolution_inherit = no
}
