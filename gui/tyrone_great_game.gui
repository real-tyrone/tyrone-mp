			textbox = { position = { 18 42 } size = { 864 42 } using = fontsize_small text = "tyrone_great_game_area_afghanistan_desc" visible = "[GetVariableSystem.Exists('tyrone_gg_selected_afghanistan')]" }
			textbox = { position = { 18 12 } size = { 864 26 } using = fontsize_large text = "tyrone_great_game_area_pakistan" visible = "[GetVariableSystem.Exists('tyrone_gg_selected_pakistan')]" }
