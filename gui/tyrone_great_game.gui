@tyrone_gg_window_width = 1320
@tyrone_gg_window_height = 820

# Map tuning knobs:
# - map_view_width/map_view_height control the GUI viewport size.
# - dds_width/dds_height control the rendered DDS size.
#   Current setup: x2 scale from the first pass, with width stretched by x1.2.
# - dds_offset_x/dds_offset_y move only the DDS textures, not the GUI or hitboxes.
#   Use these two offsets to align the painted map axis in-game.
@tyrone_gg_map_view_width = 1000
@tyrone_gg_map_view_height = 620
@tyrone_gg_dds_width = 2400
@tyrone_gg_dds_height = 1240
@tyrone_gg_dds_offset_x = -1200
@tyrone_gg_dds_offset_y = -160

types tyrone_great_game_types {
	type tyrone_great_game_region_base = icon {
		parentanchor = left|top
		position = { @tyrone_gg_dds_offset_x @tyrone_gg_dds_offset_y }
		size = { @tyrone_gg_dds_width @tyrone_gg_dds_height }
		alpha = 0.90
		color = { 0.55 0.55 0.55 1.0 }

		block "region_texture" {
			texture = ""
		}
	}

	type tyrone_great_game_region_highlight = icon {
		parentanchor = left|top
		position = { @tyrone_gg_dds_offset_x @tyrone_gg_dds_offset_y }
		size = { @tyrone_gg_dds_width @tyrone_gg_dds_height }
		alpha = 0.62
		color = { 2.4 1.8 0.35 1.0 }

		block "region_texture" {
			texture = ""
		}

		block "region_visible" {
			visible = no
		}
	}

	type tyrone_great_game_region_selected_highlight = icon {
		parentanchor = left|top
		position = { @tyrone_gg_dds_offset_x @tyrone_gg_dds_offset_y }
		size = { @tyrone_gg_dds_width @tyrone_gg_dds_height }
		alpha = 0.82
		color = { 0.25 1.25 2.6 1.0 }

		block "region_texture" {
			texture = ""
		}

		block "region_visible" {
			visible = no
		}
	}

	type tyrone_great_game_region_button = button {
		using = default_button
		alpha = 0
		alwaystransparent = no

		blockoverride "sound" {
			clicksound = "event:/SFX/UI/Global/select"
		}

		block "region_position" {
			position = { 0 0 }
		}

		block "region_size" {
			size = { 100 100 }
		}

		block "region_tooltip" {
			tooltip = ""
		}

		block "region_hover_enter" {
			onmousehierarchyenter = "[GetVariableSystem.Clear('tyrone_gg_hover_unused')]"
		}

		block "region_hover_leave" {
			onmousehierarchyleave = "[GetVariableSystem.Clear('tyrone_gg_hover_unused')]"
		}

		block "region_onclick" {
			onclick = "[GetVariableSystem.Clear('tyrone_gg_selected_unused')]"
		}
	}

	type tyrone_great_game_country_list = flowcontainer {
		direction = vertical
		position = { 12 58 }
		size = { 226 536 }
		spacing = 3

		block "country_list_visible" {
			visible = no
		}

		block "country_list_datamodel" {
			datamodel = "[GetGlobalList('tyrone_gg_countries_persia')]"
		}

		item = {
			flowcontainer = {
				visible = "[Scope.GetCountry.IsValid]"
				datacontext = "[Scope.GetCountry]"
				direction = horizontal
				size = { 226 30 }
				spacing = 7

				background = {
					using = default_background
					alpha = 0.45
				}

				small_flag = {
					parentanchor = left|vcenter
					size = { 32 22 }
					margin_left = 6
				}

				textbox = {
					parentanchor = vcenter
					layoutpolicy_horizontal = expanding
					margin_right = 6
					align = left|nobaseline
					using = elide_fontsize_min
					text = "[Country.GetNameNoFlag]"
				}
			}
		}
	}
}

window = {
	name = "tyrone_great_game_gui"
	parentanchor = hcenter|vcenter
	size = { @tyrone_gg_window_width @tyrone_gg_window_height }
	layer = layer_ingame_hud
	filter_mouse = all
	allow_outside = yes
	alwaystransparent = no
	visible = "[GetVariableSystem.Exists('tyrone_great_game_gui_open')]"
	datacontext = "[GetPlayer]"

	background = {
		using = paper_bg
	}

	default_header_clean = {
		blockoverride "text" {
			text = "tyrone_great_game_window_title"
		}
		blockoverride "size" {
			size = { @tyrone_gg_window_width 52 }
		}
	}

	close_button = {
		parentanchor = right|top
		position = { -8 4 }
		size = { 44 44 }
		onclick = "[GetVariableSystem.Clear('tyrone_great_game_gui_open')]"
		shortcut = "close_window"
	}

	widget = {
		name = "tyrone_great_game_area_countries"
		parentanchor = left|vcenter
		position = { 18 12 }
		size = { 250 620 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.82
		}

		textbox = {
			position = { 12 14 }
			size = { 226 26 }
			using = fontsize_large
			text = "tyrone_great_game_area_countries_header"
		}

		textbox = {
			position = { 12 48 }
			size = { 226 48 }
			using = fontsize_small
			text = "tyrone_great_game_area_countries_prompt"
			visible = "[Not(GetVariableSystem.Exists('tyrone_gg_any_selected'))]"
		}

		textbox = { position = { 12 48 } size = { 226 48 } using = fontsize_small text = "tyrone_great_game_area_countries_untracked" visible = "[GetVariableSystem.Exists('tyrone_gg_selected_ugyuristan')]" }
		textbox = { position = { 12 48 } size = { 226 48 } using = fontsize_small text = "tyrone_great_game_area_countries_untracked" visible = "[GetVariableSystem.Exists('tyrone_gg_selected_tibet')]" }
		textbox = { position = { 12 48 } size = { 226 48 } using = fontsize_small text = "tyrone_great_game_area_countries_untracked" visible = "[GetVariableSystem.Exists('tyrone_gg_selected_china')]" }
		textbox = { position = { 12 48 } size = { 226 48 } using = fontsize_small text = "tyrone_great_game_area_countries_untracked" visible = "[GetVariableSystem.Exists('tyrone_gg_selected_india')]" }
		textbox = { position = { 12 48 } size = { 226 48 } using = fontsize_small text = "tyrone_great_game_area_countries_untracked" visible = "[GetVariableSystem.Exists('tyrone_gg_selected_burma')]" }

		tyrone_great_game_country_list = {
			blockoverride "country_list_visible" { visible = "[GetVariableSystem.Exists('tyrone_gg_selected_persia')]" }
			blockoverride "country_list_datamodel" { datamodel = "[GetGlobalList('tyrone_gg_countries_persia')]" }
		}
		tyrone_great_game_country_list = {
			blockoverride "country_list_visible" { visible = "[GetVariableSystem.Exists('tyrone_gg_selected_afghanistan')]" }
			blockoverride "country_list_datamodel" { datamodel = "[GetGlobalList('tyrone_gg_countries_afghanistan')]" }
		}
		tyrone_great_game_country_list = {
			blockoverride "country_list_visible" { visible = "[GetVariableSystem.Exists('tyrone_gg_selected_ottoman')]" }
			blockoverride "country_list_datamodel" { datamodel = "[GetGlobalList('tyrone_gg_countries_ottoman')]" }
		}
		tyrone_great_game_country_list = {
			blockoverride "country_list_visible" { visible = "[GetVariableSystem.Exists('tyrone_gg_selected_arabia')]" }
			blockoverride "country_list_datamodel" { datamodel = "[GetGlobalList('tyrone_gg_countries_arabia')]" }
		}
		tyrone_great_game_country_list = {
			blockoverride "country_list_visible" { visible = "[GetVariableSystem.Exists('tyrone_gg_selected_kazakhstan')]" }
			blockoverride "country_list_datamodel" { datamodel = "[GetGlobalList('tyrone_gg_countries_kazakhstan')]" }
		}
		tyrone_great_game_country_list = {
			blockoverride "country_list_visible" { visible = "[GetVariableSystem.Exists('tyrone_gg_selected_pakistan')]" }
			blockoverride "country_list_datamodel" { datamodel = "[GetGlobalList('tyrone_gg_countries_pakistan')]" }
		}
		tyrone_great_game_country_list = {
			blockoverride "country_list_visible" { visible = "[GetVariableSystem.Exists('tyrone_gg_selected_mongolia')]" }
			blockoverride "country_list_datamodel" { datamodel = "[GetGlobalList('tyrone_gg_countries_mongolia')]" }
		}
	}

