		}

		# KAZAKHSTAN button
		tyrone_great_game_region_button = {
			blockoverride "region_position" { position = { 346 82 } }
			blockoverride "region_size" { size = { 160 140 } }
			blockoverride "region_tooltip" { tooltip = "tyrone_great_game_area_kazakhstan" }
			blockoverride "region_hover_enter" { onmousehierarchyenter = "[GetVariableSystem.Set('tyrone_gg_hover_kazakhstan', 'true')]" }
			blockoverride "region_hover_leave" { onmousehierarchyleave = "[GetVariableSystem.Clear('tyrone_gg_hover_kazakhstan')]" }
			blockoverride "region_onclick" {
				onclick = "[GetVariableSystem.Set('tyrone_gg_any_selected', 'true')]"
				onclick = "[GetVariableSystem.Set('tyrone_gg_selected_kazakhstan', 'true')]"
				onclick = "[GetVariableSystem.Clear('tyrone_gg_selected_mongolia')]"
				onclick = "[GetVariableSystem.Clear('tyrone_gg_selected_ugyuristan')]"
				onclick = "[GetVariableSystem.Clear('tyrone_gg_selected_tibet')]"
