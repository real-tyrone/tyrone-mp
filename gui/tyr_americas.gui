	button = {
		using = default_button
		size = { 500 38 }
		text = "tyr_am_open_map"
		onclick = "[GetScriptedGui('tyr_am_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		onclick = "[GetVariableSystem.Toggle('tyr_am_map_open')]"
		onclick = "[GetVariableSystem.Set('tyr_am_map_selection', '13')]"
		onclick = "[GetVariableSystem.Clear('tyr_am_map_hover')]"
	}
}
# HITBOX TYPES: physical pieces share one logical regional selection.
types tyr_am_map_hit_types {
	type tyr_am_hit_area_1 = button {
		using = select_button_sound
		texture = "gfx/interface/buttons/default_button_bg.dds"
		gfxtype = togglepushbuttongfx
		effectname = "NoHighlight"
		framesize = { 19 19 }
		spriteType = Corneredstretched
		spriteborder = { 0 0 }
		upframe = 1
		uphoverframe = 1
		uppressedframe = 2
		downframe = 2
		downhoverframe = 2
		downpressedframe = 1
		disableframe = 3
		alpha = 0
		enabled = "[GetScriptedGui('tyr_am_select_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		tooltip = "tyr_am_map_area_1_tt"
		onmousehierarchyenter = "[GetVariableSystem.Set('tyr_am_map_hover', '1')]"
		onmousehierarchyleave = "[GetVariableSystem.Clear('tyr_am_map_hover')]"
		onclick = "[GetScriptedGui('tyr_am_select_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		onclick = "[GetVariableSystem.Set('tyr_am_map_selection', '1')]"
	}
