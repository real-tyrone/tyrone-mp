	# HIT_TYPES_END
}

window = {
	name = "tyr_am_map_window"
	parentanchor = center
	size = { 940 770 }
	layer = windows_layer
	filter_mouse = all
	visible = "[And(GetVariableSystem.Exists('tyr_am_map_open'), GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('tyr_am_ui_phase'), '(CFixedPoint)0'))]"
	background = {
		using = default_background
	}
	popup_bg_frame = {
		alwaystransparent = yes
	}
	popup_top_header = {
		size = { 940 72 }
		alwaystransparent = yes
	}
	close_button = {
		parentanchor = right|top
