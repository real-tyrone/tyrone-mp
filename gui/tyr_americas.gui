		# VANILLA_REGION_CARDS
		flowcontainer = {
			name = "tyr_am_country_section"
			direction = vertical
			spacing = 5
			using = entry_bg_fancy
			default_header_clean_faded = {
				blockoverride "size" {
					size = { 360 34 }
				}
				blockoverride "text" {
					text = "tyr_am_diplomacy_short"
				}
				blockoverride "text_mod" {
					size = { 330 30 }
					autoresize = no
					elide = right
					fontsize_min = 14
				}
			}
			scrollarea = {
				size = { 340 58 }
				parentanchor = hcenter
				scrollbarpolicy_horizontal = always_off
				scrollwidget = {
					dynamicgridbox = {
						datamodel = "[GetPlayer.MakeScope.GetList('tyr_am_targets')]"
						datamodel_wrap = 5
						flipdirection = yes
						item = {
							widget = {
								size = { 65 52 }
								datacontext = "[Scope.GetCountry]"
								icon = {
									using = highlighted_square_selection
									size = { 62 46 }
									parentanchor = left|top
									position = { 1 0 }
									alwaystransparent = yes
									visible = "[GetScriptedGui('tyr_am_ui_selected_target').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tyr_am_candidate', Country.MakeScope).End)]"
								}
								small_flag = {
									position = { 8 7 }
									blockoverride "flag_click" {
										onclick = "[GetScriptedGui('tyr_am_select_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tyr_am_target', Country.MakeScope).End)]"
									}
									blockoverride "onhover" {}
								}
							}
						}
					}
				}
				scrollbar_vertical = {
					using = vertical_scrollbar
				}
			}
			widget = {
				name = "tyr_am_selected_country"
				size = { 340 38 }
				parentanchor = hcenter
				visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('tyr_am_ui_has_target'), '(CFixedPoint)0')]"
				datacontext = "[GetPlayer.MakeScope.Var('tyr_am_target').GetCountry]"
				textbox = {
					position = { 8 4 }
					size = { 278 28 }
					text = "[Country.GetName]"
					elide = right
					fontsize_min = 12
					align = nobaseline
					tooltip = "[Country.GetName]"
				}
				button_icon_goto = {
					position = { 302 5 }
					size = { 26 26 }
					tooltip = "GO_TO_BUTTON_COUNTRY"
					onclick = "[InformationPanelBar.OpenCountryPanel(Country.Self)]"
					onclick = "[GetVariableSystem.Clear('tyr_am_map_open')]"
				}
			}
			textbox = {
				size = { 340 30 }
				parentanchor = hcenter
				align = hcenter|nobaseline
				text = "tyr_am_select_country_short"
				using = fontsize_medium
				visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('tyr_am_ui_has_target'), '(CFixedPoint)0'))]"
			}
		}
