# Injected only by je_tyrone_widget_test. Plain rows, no tooltip widgets.
flowcontainer = {
	name = "tyrone_test_subentries_widget"
	parentanchor = hcenter
	direction = vertical
	spacing = 3

	textbox = {
		size = { 488 20 }
		text = "tyrone_widget_test_heading"
		align = left|vcenter|nobaseline
		using = regular_font
		fontsize = 13
		alpha = 0.8
	}

	flowcontainer = {
		direction = vertical
		spacing = 3
		datamodel = "[AccessPlayer.AccessActiveJournalEntries]"
		item = {
			button = {
				size = { 488 46 }
				using = default_button
				color = { 0.65 0.95 0.65 1 }
				visible = "[Or(EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_widget_test_sub_1')), Or(EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_widget_test_sub_2')), EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_widget_test_sub_3'))))]"
				onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"

				icon = {
					position = { 10 9 }
					size = { 28 28 }
					texture = "[JournalEntry.GetIcon]"
					alwaystransparent = yes
				}
				textbox = {
					position = { 48 3 }
					size = { 428 40 }
					text = "[JournalEntry.GetName]"
					align = left|vcenter|nobaseline
					using = regular_font
					fontsize = 19
					elide = right
					alwaystransparent = yes
				}
			}
		}
	}
}
