		widget = {
			size = { 488 172 }
			visible = "[GetScriptedGui('tyr_gcol_maf_stats').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			datacontext = "[JournalEntry.GetCountry.MakeScope.Var('tyr_gcol_maf_country').GetCountry]"
