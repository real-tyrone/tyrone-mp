			blockoverride "layout" {
				size = { 488 38 }
			}
			blockoverride "left_text" {
				raw_text = "tyr_gcol_maf_subsidies"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('tyr_gcol_maf_expanded')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('tyr_gcol_maf_expanded'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('tyr_gcol_maf_expanded')]"
			}
