### Bismarck Journal Entry widgets

flowcontainer = {
	name = "widget_je_bismarck_reform_portrait"
	ignoreinvisible = yes
	direction = vertical

	fixedgridbox = {
		parentanchor = hcenter
		size = { 520 440 }
		minimumsize = { 520 440 }
		addcolumn = 520
		addrow = 440
		datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('bismarck_scope_gui')]"

		item = {
			container = {
				datacontext = "[Scope.GetCharacter]"
				parentanchor = center

				flowcontainer = {
					direction = vertical

					background = {
						using = entry_bg
					}

					character_portrait_base = {
						size = { 320 350 }
						parentanchor = hcenter

						blockoverride "show_hat" {
							scissor = yes
						}
						blockoverride "portrait_texture" {
							portrait_texture = "[Character.GetAnimatedPortrait('environment_standard_V1', 'camera_event_right', 'idle', GetPortraitRenderSize(PdxGuiWidget.Self))]"
						}
						blockoverride "portrait_size" {
							size = { 320 390 }
						}
						blockoverride "portrait_position" {
							position = { 0 -18 }
						}
						blockoverride "portrait_frame" {
							icon = {
								texture = "gfx/interface/portraits/portrait_frame_torso_historical_no_info_link.dds"
								size = { 100% 330 }
								position = { 0 3 }
								parentanchor = bottom|hcenter
								using = naval_commander_color
							}
						}
						blockoverride "portrait_icons" {}
						blockoverride "highlight" {}
					}

					default_header_clean_faded = {
						size = { 250 60 }
						parentanchor = hcenter
						margin = { 10 10 }
						blockoverride "text" {}

						textbox = {
							text = "[Character.GetFullNameNoFormatting]"
							parentanchor = center
							position = { 0 -3 }
							autoresize = yes
							max_width = 256
							using = fontsize_large
						}
					}
				}
			}
		}
	}
}
