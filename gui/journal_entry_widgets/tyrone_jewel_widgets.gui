# Native character presentation on a continuous painted government panel.
widget = {
	name = "tyrone_jewel_governor_widget"
	parentanchor = hcenter
	size = { 488 304 }
	datacontext = "[JournalEntry.GetTopScope.sCountry('csr_india')]"
	visible = "[Country.IsValid]"

	widget = {
		position = { 4 8 }
		size = { 480 284 }
		background = {
			using = dark_area_rounded
			alpha = 0.7
		}
		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/illustrations/government/government_illustration.dds"
			alpha = 0.55
			modify_texture = { using = simple_frame_mask }
			modify_texture = {
				texture = "gfx/interface/backgrounds/default_bg_shading.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = overlay
			}
			modify_texture = {
				using = texture_velvet
				alpha = 0.3
			}
			alwaystransparent = yes
		}
		widget = {
			position = { 218 12 }
			size = { 250 260 }
			background = {
				using = dark_area_rounded
				alpha = 0.65
			}
		}

		widget = {
			datacontext = "[Country.GetRuler]"
			visible = "[Character.IsValid]"
			size = { 100% 100% }
			character_portrait_large_torso = {
				position = { 0 10 }
				blockoverride "show_hat" {}
				blockoverride "highlight" {}
				blockoverride "portrait_icons" {}
			}
			textbox = {
				position = { 230 16 }
				size = { 226 22 }
				text = "tyrone_jewel_governor_heading"
				using = regular_font
				fontsize = 15
				fontcolor = { 0.78 0.71 0.54 1 }
				align = left|vcenter|nobaseline
				alwaystransparent = yes
			}
			textbox = {
				position = { 230 42 }
				size = { 226 44 }
				text = "[Character.GetFullNameNoFormatting]"
				using = regular_font
				fontsize = 21
				fontcolor = { 0.93 0.90 0.82 1 }
				align = left|vcenter|nobaseline
				multiline = yes
				alwaystransparent = yes
			}
			icon = {
				position = { 230 92 }
				size = { 226 2 }
				texture = "gfx/interface/dividers/divider_clean.dds"
				spriteType = Corneredtiled
				spriteborder = { 4 0 }
				texture_density = 2
				alpha = 0.4
				alwaystransparent = yes
			}
			textbox = {
				position = { 230 102 }
				size = { 226 22 }
				text = "tyrone_jewel_governor_traits"
				using = regular_font
				fontsize = 15
				fontcolor = { 0.78 0.71 0.54 1 }
				alwaystransparent = yes
			}
			flowcontainer = {
				position = { 230 130 }
				direction = vertical
				spacing = 3
				datamodel = "[Character.AccessTraits]"
				item = {
					widget = {
						size = { 226 30 }
						using = tooltip_above
						tooltipwidget = { FancyTooltip_CharacterTrait = {} }
						icon = {
							size = { 20 28 }
							texture = "[CharacterTrait.GetTexture]"
						}
						textbox = {
							position = { 28 0 }
							size = { 196 30 }
							text = "[CharacterTrait.GetNameNoFormatting]"
							using = regular_font
							fontsize = 15
							fontcolor = { 0.9 0.87 0.8 1 }
							align = left|vcenter|nobaseline
							elide = right
							alwaystransparent = yes
						}
					}
				}
			}
		}
		icon = {
			size = { 100% 100% }
			using = simple_frame
			alpha = 0.8
			alwaystransparent = yes
		}
	}
}
