widget = {
 name = "tyr_forbidden_city_palace"
 size = { 488 300 }
 parentanchor = hcenter
 background = { using = dark_area }
 background = { using = frame_small }
 button = {
  position = { 18 18 }
  size = { 116 116 }
  datacontext = "[JournalEntry.GetCountry.GetCapital.GetBuilding('building_forbidden_city')]"
  enabled = "[Building.IsValid]"
  onclick = "[InformationPanelBar.OpenBuildingDetailsPanel(Building.AccessSelf)]"
  tooltip = "tyr_forbidden_city_open_building"
  icon = { size = { 116 116 } texture = "gfx/interface/icons/building_icons/forbidden_city.dds" ignoreinput = yes }
 }
 textbox = {
  position = { 150 22 }
  size = { 316 36 }
  text = "tyr_forbidden_city_palace_heading"
  using = fontsize_medium
  default_format = "#gold"
  align = left|nobaseline
 }
 textbox = {
  position = { 150 64 }
  size = { 316 80 }
  text = "tyr_forbidden_city_palace_subtitle"
  multiline = yes
  align = left|nobaseline
 }
 divider_decorative = { position = { 24 148 } size = { 440 8 } }
 textbox = {
  position = { 24 170 }
  size = { 440 32 }
  text = "tyr_forbidden_city_subject_count"
  align = left|nobaseline
 }
 textbox = {
  position = { 24 210 }
  size = { 440 66 }
  text = "tyr_forbidden_city_beijing_totals"
  multiline = yes
  align = left|nobaseline
 }
}
