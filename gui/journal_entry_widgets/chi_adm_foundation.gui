    spriteType = Corneredstretched
    spriteborder = { 6 6 }
    texture_density = 2
   }
  }
 }
 divider_decorative = { position = { 24 330 } size = { 440 8 } alpha = 0.65 }
 textbox = {
  position = { 24 344 }
  size = { 440 22 }
  text = "chi_adm_bureaucracy_display"
  tooltip = "chi_adm_bureaucracy_tooltip"
  align = left|nobaseline
 }
 textbox = {
  position = { 24 372 }
