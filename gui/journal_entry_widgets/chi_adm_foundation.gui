# provincial accounts dossier refinement. Direct country-variable bindings; no monthly bar sync.
widget = {
 name = "chi_adm_foundation"
 size = { 488 406 }
 parentanchor = hcenter
 background = { using = dark_area }
 background = { using = frame_small }
 icon = {
  position = { 18 14 }
  size = { 42 42 }
  texture = "gfx/interface/icons/event_icons/qing_patriot_icon.dds"
 }
 textbox = {
  position = { 70 14 }
  size = { 394 28 }
  text = "chi_adm_dossier_title"
  default_format = "#gold"
  using = fontsize_medium
  align = left|nobaseline
 }
 textbox = {
  position = { 70 43 }
  size = { 394 24 }
  text = "chi_adm_dossier_province"
  align = left|nobaseline
  elide = right
 }
 divider_decorative = { position = { 24 76 } size = { 440 8 } }
 widget = {
  position = { 24 94 }
  size = { 440 68 }
  tooltip = "chi_adm_loyalty_tooltip"
  textbox = {
   size = { 220 26 }
   text = "chi_adm_loyalty_display"
   align = left|nobaseline
  }
  textbox = {
   position = { 220 0 }
   size = { 220 26 }
   text = "chi_adm_loyalty_tier_display"
   align = right|nobaseline
   default_format = "#gold"
   elide = right
  }
  progressbar = {
   position = { 0 32 }
   size = { 440 20 }
   min = 0
   max = 100
   value = "[FixedPointToFloat(JournalEntry.GetCountry.MakeScope.Var('chi_adm_loyalty').GetValue)]"
   progresstexture = "gfx/interface/progressbar/progressbar_gold.dds"
   noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds"
   direction = horizontal
   skip_initial_animation = yes
  }
  widget = {
   position = { 0 32 }
   size = { 440 20 }
   background = {
    texture = "gfx/interface/progressbar/progressbar_frame.dds"
    spriteType = Corneredstretched
    spriteborder = { 6 6 }
    texture_density = 2
   }
  }
 }
 widget = {
  position = { 24 174 }
  size = { 440 68 }
  tooltip = "chi_adm_autonomy_tooltip"
  textbox = {
   size = { 220 26 }
   text = "chi_adm_autonomy_display"
   align = left|nobaseline
  }
  textbox = {
   position = { 220 0 }
   size = { 220 26 }
   text = "chi_adm_autonomy_tier_display"
   align = right|nobaseline
   default_format = "#gold"
   elide = right
  }
  progressbar = {
   position = { 0 32 }
   size = { 440 20 }
   min = 0
   max = 100
   value = "[FixedPointToFloat(JournalEntry.GetCountry.MakeScope.Var('chi_adm_autonomy').GetValue)]"
   progresstexture = "gfx/interface/progressbar/progressbar_default.dds"
   noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds"
   direction = horizontal
   skip_initial_animation = yes
  }
  widget = {
   position = { 0 32 }
   size = { 440 20 }
   background = {
    texture = "gfx/interface/progressbar/progressbar_frame.dds"
    spriteType = Corneredstretched
    spriteborder = { 6 6 }
    texture_density = 2
   }
  }
 }
 widget = {
  position = { 24 254 }
  size = { 440 68 }
  tooltip = "chi_adm_corruption_tooltip"
  textbox = {
   size = { 220 26 }
   text = "chi_adm_corruption_display"
   align = left|nobaseline
  }
  textbox = {
   position = { 220 0 }
   size = { 220 26 }
   text = "chi_adm_corruption_tier_display"
   align = right|nobaseline
   default_format = "#gold"
   elide = right
  }
  progressbar = {
   position = { 0 32 }
   size = { 440 20 }
   min = 0
   max = 100
   value = "[FixedPointToFloat(JournalEntry.GetCountry.MakeScope.Var('chi_adm_corruption').GetValue)]"
