### Great Game JE List
flowcontainer = {
	name = "widget_tyr_bt_children"

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		spacing = 4
		datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"

		item = {
			flowcontainer = {
				visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_balkan_theater').Self)]"
				direction = vertical
				spacing = 4

				textbox = {
					autoresize = yes
					align = nobaseline
					default_format = "#title"
					margin_bottom = 2
					text = "tyr_bt_children"
				}

				flowcontainer = {
					direction = vertical
					spacing = 4
					ignoreinvisible = yes
					datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"

					item = {
						journal_entry = {
							visible = "[Not(ObjectsEqual(JournalEntryType.Self, JournalEntryPanel.GetJournalEntryType.Self))]"
							datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
						}
					}
				}
			}
		}
	}
}

# Live vanilla movement cards, bound to the Ottoman country rather than the viewer.
flowcontainer = {
	name = "widget_tyr_bt_ottoman_balkan_movements"
	direction = vertical
	parentanchor = hcenter
	spacing = 5
	ignoreinvisible = yes

	textbox = {
		autoresize = yes
		align = nobaseline
		default_format = "#title"
		margin_bottom = 2
		text = "tyr_bt_ottoman_movements_header"
	}

	flowcontainer = {
		visible = "[GetScriptedGui('tyr_bt_ottomans_exist').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		datacontext = "[GetGlobalVariable('tyr_bt_tur_country').GetCountry]"
		direction = vertical
		parentanchor = hcenter
		spacing = 5
		ignoreinvisible = yes

		empty_state = {
			blockoverride "visible" {
				visible = "[Not(GetScriptedGui('tyr_bt_ottomans_have_balkan_movements').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			}
			blockoverride "text" {
				text = "tyr_bt_no_ottoman_balkan_movements"
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			spacing = 5
			ignoreinvisible = yes
			datamodel = "[Country.AccessPoliticalMovements]"

			item = {
				politics_panel_political_movement_item = {
					visible = "[GetScriptedGui('tyr_bt_balkan_movement_visible').IsValid(GuiScope.SetRoot(PoliticalMovement.MakeScope).End)]"
				}
			}
		}
	}
}
