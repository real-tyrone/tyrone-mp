# Centered slot insets
# Aligned action cells
# Industrial GUI visual polish
# Dossier layout: vanilla components, inspired by Morgenrote's occupation panels.
flowcontainer = {
	name = "widget_tyr_gir_chancellor"
	direction = vertical
	ignoreinvisible = yes
	spacing = 8

	widget = {
		name = "tyr_gir_dossier"
		size = { 520 338 }
		background = {
			using = entry_bg
		}
		fixedgridbox = {
			size = { 520 338 }
			addcolumn = 520
			addrow = 338
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('tyr_gir_portrait')]"
			item = {
				widget = {
					size = { 520 338 }
					datacontext = "[Scope.GetCharacter]"
					widget = {
						position = { 10 12 }
						size = { 250 270 }
						character_portrait_base = {
							size = { 250 270 }
							parentanchor = hcenter
							blockoverride "show_hat" {
								scissor = yes
							}
							blockoverride "portrait_texture" {
								portrait_texture = "[Character.GetAnimatedPortrait('environment_standard_V1', 'camera_torso', 'idle', GetPortraitRenderSize(PdxGuiWidget.Self))]"
							}
							blockoverride "portrait_size" {
								size = { 230 292 }
							}
							blockoverride "portrait_position" {
								position = { 0 -4 }
							}
							blockoverride "portrait_frame" {
								icon = {
									texture = "gfx/interface/portraits/portrait_frame_torso_historical_no_info_link.dds"
									size = { 100% 263 }
									position = { 0 3 }
									parentanchor = bottom|hcenter
									using = naval_commander_color
								}
							}
							blockoverride "portrait_icons" {}
							blockoverride "highlight" {}
						}
					}
					default_header_clean_faded = {
						size = { 496 48 }
						position = { 0 282 }
						parentanchor = hcenter
						blockoverride "text" {}
						textbox = {
							size = { 470 44 }
							parentanchor = center
							text = "[Character.GetFullNameNoFormatting]"
							align = center
							multiline = yes
							elide = right
							fontsize_min = 14
							using = fontsize_large
						}
					}
				}
			}
		}
		flowcontainer = {
			position = { 278 26 }
			direction = vertical
			spacing = 2
			textbox = {
				size = { 224 24 }
				text = "tyr_gir_v2_phase"
				align = center
				multiline = yes
				using = fontsize_medium
				alpha = 0.8
			}
			textbox = {
				size = { 224 42 }
				text = "tyr_gir_gui_phase_value"
				align = center
				multiline = yes
				using = fontsize_large
			}
			divider_decorative = {
				size = { 224 8 }
				alpha = 0.42
			}
			textbox = {
				size = { 224 24 }
				text = "tyr_gir_gui_family_label"
				align = center
				multiline = yes
				using = fontsize_medium
				alpha = 0.8
			}
			textbox = {
				size = { 224 42 }
				text = "tyr_gir_gui_family_value"
				align = center
				multiline = yes
				using = fontsize_large
			}
			divider_decorative = {
				size = { 224 8 }
				alpha = 0.42
			}
			textbox = {
				size = { 224 24 }
				text = "tyr_gir_gui_zone_label"
				align = center
				multiline = yes
				using = fontsize_medium
				alpha = 0.8
			}
			textbox = {
				size = { 224 42 }
				text = "tyr_gir_gui_zone_value"
				align = center
				multiline = yes
				using = fontsize_large
			}
			widget = {
				size = { 1 8 }
			}
		}
	}

	flowcontainer = {
		name = "tyr_gir_level_panel"
		parentanchor = hcenter
		direction = vertical
		spacing = 4
		margin = { 16 10 }
		background = {
			using = entry_bg
		}
