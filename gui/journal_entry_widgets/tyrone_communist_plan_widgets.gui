# Communist reforms and active famines, shown by Five-Year Plans.
flowcontainer = {
	name = "tyrone_cp_subentries_widget"
	parentanchor = hcenter
	direction = vertical
	spacing = 5

	widget = {
		size = { 488 26 }
		textbox = {
			size = { 164 26 }
			text = "tyrone_cp_heading"
			align = left|vcenter|nobaseline
			using = regular_font
			fontsize = 15
			fontcolor = { 0.78 0.71 0.54 1 }
			alwaystransparent = yes
