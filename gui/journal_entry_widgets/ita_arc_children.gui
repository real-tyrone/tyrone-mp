flowcontainer = {
	name = "ita_arc_children"
	direction = vertical
	spacing = 4
	ignoreinvisible = yes
	datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
	item = {
		flowcontainer = {
			visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_italy_tyrone').Self)]"
			direction = vertical
			spacing = 4
			ignoreinvisible = yes
			datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"
			item = {
				journal_entry = {
					visible = "[Or(EqualTo_string(JournalEntryType.GetName, Localize('italy_diplo_stance')), EqualTo_string(JournalEntryType.GetName, Localize('Spenna_la_gallina_austriaca')))]"
					datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
				}
			}
		}
	}
}
