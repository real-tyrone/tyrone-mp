# Native Great Game / Imperialism of Promise pattern: named root is not a model.
flowcontainer = {
 name = "chi_adm_court_register_court_subentries"
 ignoreinvisible = yes
 flowcontainer = {
  direction = vertical
  parentanchor = hcenter
  spacing = 4
  datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
  item = {
   flowcontainer = {
    visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_chi_adm_court_register_court').Self)]"
    direction = vertical
    spacing = 4
    flowcontainer = {
     direction = vertical
     spacing = 4
     ignoreinvisible = yes
     datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"
     item = {
      journal_entry = {
       visible = "[Not(ObjectsEqual(JournalEntryType.Self, JournalEntryPanel.GetJournalEntryType.Self))]"
       datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
      }
     }
    }
   }
  }
 }
}
