flowcontainer = {
	name = "chi_mandate_progress_dropdowns"
	direction = vertical
	parentanchor = hcenter
	spacing = 3
	ignoreinvisible = yes

	section_header_button = {
		blockoverride "layout" {
			size = { 512 38 }
			parentanchor = hcenter
		}
		blockoverride "left_text" {
			text = "chi_centralisation_advancement_1"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('chi_mandate_positive_effects_open')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('chi_mandate_positive_effects_open'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('chi_mandate_positive_effects_open')]"
		}
	}

	flowcontainer = {
		direction = vertical
		spacing = 2
		visible = "[GetVariableSystem.Exists('chi_mandate_positive_effects_open')]"
		margin = { 12 8 }
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_mixed_economic_policy_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_industry_banned_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
	}

	section_header_button = {
		blockoverride "layout" {
			size = { 512 38 }
			parentanchor = hcenter
		}
		blockoverride "left_text" {
			text = "chi_centralisation_decrease_1"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('chi_mandate_negative_effects_open')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('chi_mandate_negative_effects_open'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('chi_mandate_negative_effects_open')]"
		}
	}

	flowcontainer = {
		direction = vertical
		spacing = 2
		visible = "[GetVariableSystem.Exists('chi_mandate_negative_effects_open')]"
		margin = { 12 8 }
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_monarchy_loss_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_opium_wars_loss_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_taiping_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_loan_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_civil_war_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_heavenly_retake_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_boxer_rebellion_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
		textbox = {
			size = { 488 30 }
			text = "chi_centralisation_coup_effect"
			align = left|vcenter|nobaseline
			using = fontsize_medium
		}
	}
}
