flowcontainer = {
 name = "chi_adm_religious_affairs_overview"
 direction = vertical
 parentanchor = hcenter
 spacing = 10

 flowcontainer = {
  direction = vertical
  spacing = 6
  ignoreinvisible = yes
  datamodel = "[JournalEntry.GetScriptedButtons]"
  item = {
   button = {
    size = { 472 44 }
    using = default_button_action
    visible = "[ScriptedButton.IsVisible]"
    enabled = "[IsValid(ScriptedButton.ExecuteEffect)]"
    onclick = "[Execute(ScriptedButton.ExecuteEffect)]"
    tooltip = "SCRIPTED_ACTION_TOOLTIP"
    textbox = {
     autoresize = yes
     parentanchor = center
     align = center|nobaseline
     text = "[ScriptedButton.GetName]"
     alwaystransparent = yes
    }
   }
  }
 }

 flowcontainer = {
  direction = vertical
  spacing = 8
  margin = { 16 14 }
  background = { using = dark_area }
  background = { using = frame_small }
  textbox = {
   size = { 440 0 }
   max_width = 440
   autoresize = yes
   multiline = yes
   text = "chi_adm_religious_overview_heading"
  }
  textbox = {
   size = { 440 0 }
   max_width = 440
   autoresize = yes
   multiline = yes
   text = "chi_adm_religious_overview_stats"
  }
  textbox = {
   size = { 440 0 }
   max_width = 440
   autoresize = yes
   multiline = yes
   text = "chi_adm_religious_overview_legend"
  }
 }
}
