flowcontainer = {
 name = "chi_adm_reform_army_reviews"
 direction = vertical
 parentanchor = hcenter
 spacing = 4
 visible = "[GreaterThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.ScriptValue('chi_adm_reform_army_review_length'), '(CFixedPoint)0')]"
 textbox = {
  text = "chi_adm_reform_army_reviews_display"
  autoresize = yes
  align = nobaseline
 }
 progressbar = {
  size = { 440 16 }
  direction = horizontal
  min = 0
  max = "[FixedPointToFloat(JournalEntry.GetCountry.MakeScope.ScriptValue('chi_adm_reform_army_review_length'))]"
  value = "[FixedPointToFloat(JournalEntry.GetCountry.MakeScope.ScriptValue('chi_adm_reform_army_reviews_completed'))]"
  progresstexture = "gfx/interface/progressbar/progressbar_gold.dds"
  noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds"
  skip_initial_animation = yes
 }
}

