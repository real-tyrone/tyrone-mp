# Imperial reforms, shown only by the Empire of India parent JE.
flowcontainer = {
	name = "tyrone_empire_of_india_subentries_widget"
	parentanchor = hcenter
	direction = vertical
	spacing = 5

	widget = {
		size = { 488 26 }
		textbox = {
			size = { 164 26 }
			text = "tyrone_eoi_heading"
			align = left|vcenter|nobaseline
			using = regular_font
			fontsize = 15
			fontcolor = { 0.78 0.71 0.54 1 }
			alwaystransparent = yes
		}
		icon = {
			position = { 174 13 }
			size = { 314 2 }
			texture = "gfx/interface/dividers/divider_clean.dds"
			spriteType = Corneredtiled
			spriteborder = { 4 0 }
			texture_density = 2
			alpha = 0.35
			alwaystransparent = yes
		}
	}

	flowcontainer = {
		direction = vertical
		spacing = 7
		datamodel = "[AccessPlayer.AccessActiveJournalEntries]"
		item = {
			button = {
				size = { 488 54 }
				using = default_button
				texture = "gfx/interface/buttons/default_button_bg_map_interaction.dds"
				# Keep the same physical frame pixels at half the native density:
				# this enlarges the rounded corners rather than stretching them.
				texture_density = 1
				framesize = { 38 38 }
				spriteborder = { 14 14 }
				blockoverride "bevel_texture" {
					texture = "gfx/interface/buttons/default_button_bevel_map_interaction.dds"
				}
				blockoverride "bevel_margin" {
					margin = { 6 6 }
				}
				visible = "[Or(EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_eoi_calcutta')), Or(EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_eoi_civil_service')), Or(EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_eoi_gendarmerie')), Or(EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_eoi_council')), Or(EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_eoi_coronation')), EqualTo_string(JournalEntry.GetName, Localize('je_tyrone_eoi_home_rule')))))))]"
				onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"

				icon = {
					name = "tyrone_promise_card_brass_edge"
					size = { 100% 100% }
					texture = "gfx/interface/buttons/default_button_frame_map_interaction.dds"
					spriteType = Corneredstretched
					spriteborder = { 24 24 }
					texture_density = 1
					color = { 0.72 0.72 0.66 1 }
					alpha = 0.7
					alwaystransparent = yes
				}
				icon = {
					position = { 12 9 }
					size = { 36 36 }
					using = circle_bg_simple_dark
					alpha = 0.65
					alwaystransparent = yes
				}
				icon = {
					position = { 17 14 }
					size = { 26 26 }
					texture = "[JournalEntry.GetIcon]"
					alwaystransparent = yes
				}
				textbox = {
					position = { 60 5 }
					size = { 394 44 }
					text = "[JournalEntry.GetName]"
					align = left|vcenter|nobaseline
					using = regular_font
					fontsize = 20
					fontcolor = { 0.93 0.90 0.82 1 }
					elide = right
					alwaystransparent = yes
				}
				icon = {
					position = { 465 18 }
					size = { 8 18 }
					texture = "gfx/interface/politics_view/summary_arrow_right.dds"
					alpha = 0.6
					alwaystransparent = yes
				}
			}
		}
	}
}
