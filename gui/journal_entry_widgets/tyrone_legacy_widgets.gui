flowcontainer = {
	name = "tyr_berlin_controls"
	direction = vertical
	parentanchor = hcenter
	spacing = 10
	textbox = {
		size = { 100 20 }
		visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_berlin_conference'))]"
		background = {
			using = fade_right_simple
			margin_left = 10
		}
		margin = { 10 10 }
		text = "tyr_berlin_remaining_claims"
		parentanchor = left
		position = { 0 -7 }
		autoresize = yes
		max_width = 256
	}
	container = {
		parentanchor = hcenter
		visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_berlin_conference'))]"
		minimumsize = { @panel_width_minus_30 -1 }
		background = {
			alpha = 0.4
			using = entry_bg_fancy_dark
		}
		container = {
			visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_berlin_conference'))]"
			parentanchor = hcenter
			claimed_countries_gui = {}
		}
	}
}

container = {
	name = "tyr_bonapartist_palace"
	parentanchor = hcenter
	visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_post_bonapartists'))]"
	minimumsize = { @panel_width_minus_30 -1 }
	background = {
		alpha = 0.5
		using = entry_bg_fancy_dark
	}
	container = {
		visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_post_bonapartists'))]"
		parentanchor = hcenter
		empire_of_france = {}
	}
}


widget = {
	name = "tyr_bonapartist_portrait"
	visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_post_bonapartists'))]"

	size = { @panel_width_plus_20 290 }
	parentanchor = hcenter
	datacontext = "[JournalEntry.GetCountry.GetRuler]"
	character_portrait_large_torso = {
		position = { 0 0 }
		parentanchor = hcenter
		blockoverride "show_hat" {}
		blockoverride "tooltip" {}
		blockoverride "portrait_icons" {}
		blockoverride "portrait_button" {}
	}
	default_header_clean_faded = {
		visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_post_bonapartists'))]"
		size = { 250 40 }
		position = { 0 258 }
		blockoverride "text" {}
		parentanchor = hcenter
		textbox = {
			text = "mr_emperor"
			parentanchor = vcenter|hcenter
			position = { 0 -3 }
			autoresize = yes
			max_width = 256
			using = fontsize_large
		}
	}
}

widget = {
	name = "tyr_spanish_bonapartist_portrait"
	visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_spain_napoleonic_reforms'))]"

	size = { @panel_width_plus_20 290 }
	parentanchor = hcenter
	datacontext = "[JournalEntry.GetCountry.GetRuler]"
	character_portrait_large_torso = {
		position = { 0 0 }
		parentanchor = hcenter
		blockoverride "show_hat" {}
		blockoverride "tooltip" {}
		blockoverride "portrait_icons" {}
		blockoverride "portrait_button" {}
	}
	default_header_clean_faded = {
		visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_spain_napoleonic_reforms'))]"
		size = { 250 40 }
		position = { 0 258 }
		blockoverride "text" {}
		parentanchor = hcenter
		textbox = {
			text = "[JournalEntry.GetCountry.GetRuler.GetFullName]"
			parentanchor = vcenter|hcenter
			position = { 0 -3 }
			autoresize = yes
			max_width = 256
			using = fontsize_large
		}
	}
}

flowcontainer = {
	name = "tyr_italy_content"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	spacing = 10
	italy_je_characters = {}
	italy_risorgimento_quote = {}
	italy_irredentism_illustration = {}
	italy_jewelcolony_illustration = {}
	italy_developing_industry_bars = {}
}


flowcontainer = {
	name = "tyr_scw_progress_conditions"
	direction = vertical
	parentanchor = hcenter
	spacing = 5
	flowcontainer = {
		direction = vertical
		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}
		section_header_button = {
			blockoverride "layout" { size = { @panel_width_plus_10 38 } }
			blockoverride "left_text" { text = "scw_regions_bar" }
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('scw_regions_conditions_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('scw_regions_conditions_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('scw_regions_conditions_open')]"
			}
		}
		flowcontainer = {
			visible = "[GetVariableSystem.Exists('scw_regions_conditions_open')]"
			direction = vertical
			ignoreinvisible = yes
			margin = { 10 10 }
			parentanchor = hcenter
			tooltip = "scw_regions_bar_tooltip"
			textbox = {
				text = "scw_ui_regions_intro"
				autoresize = yes
				multiline = yes
				min_width = @panel_width_minus_30
				max_width = @panel_width_minus_30
				align = nobaseline
			}
			textbox = {
				text = "scw_ui_region_mexico_caribbean"
				autoresize = yes
				multiline = yes
				min_width = @panel_width_minus_30
				max_width = @panel_width_minus_30
