	flowcontainer = {
		direction = vertical
		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}
		section_header_button = {
			blockoverride "layout" { size = { @panel_width_plus_10 38 } }
			blockoverride "left_text" { text = "scw_institutions_bar" }
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('scw_institutions_conditions_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('scw_institutions_conditions_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('scw_institutions_conditions_open')]"
			}
		}
		flowcontainer = {
			visible = "[GetVariableSystem.Exists('scw_institutions_conditions_open')]"
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			margin = { 10 10 }
			tooltip = "scw_institutions_bar_tooltip"
			textbox = {
				visible = "[Not(StringIsEmpty(JournalEntry.GetAdvanceDesc))]"
				text = "[JournalEntry.GetAdvanceDesc]"
				autoresize = yes
				multiline = yes
				min_width = @panel_width_minus_30
				max_width = @panel_width_minus_30
				align = nobaseline
			}
			textbox = {
				visible = "[Not(StringIsEmpty(JournalEntry.GetDepleteDesc))]"
				text = "[JournalEntry.GetDepleteDesc]"
				autoresize = yes
				multiline = yes
				min_width = @panel_width_minus_30
				max_width = @panel_width_minus_30
				align = nobaseline
				margin_top = 10
			}
			textbox = {
				text = "scw_ui_institutions_event_rewards"
				autoresize = yes
				multiline = yes
				min_width = @panel_width_minus_30
				max_width = @panel_width_minus_30
				align = nobaseline
				margin_top = 12
			}
		}
	}
	flowcontainer = {
		direction = vertical
		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}
		section_header_button = {
			blockoverride "layout" { size = { @panel_width_plus_10 38 } }
			blockoverride "left_text" { text = "scw_consolidation_bar" }
