flowcontainer = {
 name = "tyr_us_policy_children"
 direction = vertical
 parentanchor = hcenter
 spacing = 4
 ignoreinvisible = yes
 flowcontainer = {
  direction = vertical
  ignoreinvisible = yes
  datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
  item = {
   flowcontainer = {
    visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_tyr_us_foreign_policy').Self)]"
    direction = vertical
    spacing = 4
    ignoreinvisible = yes
    textbox = { autoresize = yes align = nobaseline default_format = "#title" text = "tyr_us_children_heading" }
    flowcontainer = {
     direction = vertical
     ignoreinvisible = yes
