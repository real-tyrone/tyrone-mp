flowcontainer = {
name = "chi_adm_provincial_development_status"
direction = vertical
spacing = 8
datacontext = "[JournalEntry.GetCountry]"
textbox = { size = { 440 0 } max_width = 440 autoresize = yes multiline = yes text = "chi_adm_provincial_development_status" }
progressbar = { visible = "[GetScriptedGui('chi_adm_provincial_development_project_visible').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]" progresstexture = "gfx/interface/progressbar/progressbar_gold.dds" noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds" direction = horizontal size = { 440 16 } min = 0 max = 100 value = "[FixedPointToFloat(Country.MakeScope.ScriptValue('chi_adm_provincial_development_project_progress'))]" }
progressbar = { visible = "[GetScriptedGui('chi_adm_provincial_development_conversion_visible').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]" progresstexture = "gfx/interface/progressbar/progressbar_gold.dds" noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds" direction = horizontal size = { 440 16 } min = 0 max = 100 value = "[FixedPointToFloat(Country.MakeScope.ScriptValue('chi_adm_provincial_development_conversion_progress'))]" }
}
flowcontainer = {
	name = "chi_adm_provincial_development_court_status"
	direction = vertical
	spacing = 6
	parentanchor = hcenter
	ignoreinvisible = yes
	datamodel = "[AccessPlayer.GetSubjects]"
	item = {
		flowcontainer = {
			direction = vertical
			spacing = 6
			ignoreinvisible = yes
			visible = "[GetScriptedGui('chi_adm_negotiated_integration_row').IsValid(GuiScope.SetRoot(Country.MakeScope).End)]"
			section_header_button = {
				blockoverride "layout" { size = { 472 38 } }
				blockoverride "left_text" { text = "[Country.GetNameNoFormatting]" }
				blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle(Concatenate('chi_adm_provincial_development_row_', Country.GetNameNoFormatting))]" }
				blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists(Concatenate('chi_adm_provincial_development_row_', Country.GetNameNoFormatting)))]" }
				blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists(Concatenate('chi_adm_provincial_development_row_', Country.GetNameNoFormatting))]" }
			}
			flowcontainer = {
				direction = vertical
				spacing = 8
				margin = { 16 10 }
				ignoreinvisible = yes
				visible = "[GetVariableSystem.Exists(Concatenate('chi_adm_provincial_development_row_', Country.GetNameNoFormatting))]"
				widget = {
					size = { 440 66 }
					background = { using = dark_area }
					background = { using = frame_small }
					widget = {
						position = { 8 10 } size = { 136 46 }
						tooltip = "chi_adm_memorials_compact_loyalty_tooltip"
						textbox = { size = { 136 26 } align = center|nobaseline text = "chi_adm_memorials_compact_loyalty" }
						progressbar = { position = { 0 32 } size = { 136 10 } min = 0 max = 100 value = "[FixedPointToFloat(Country.MakeScope.Var('chi_adm_loyalty').GetValue)]" progresstexture = "gfx/interface/progressbar/progressbar_gold.dds" noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds" direction = horizontal skip_initial_animation = yes }
					}
					widget = {
						position = { 152 10 } size = { 136 46 }
						tooltip = "chi_adm_memorials_compact_autonomy_tooltip"
						textbox = { size = { 136 26 } align = center|nobaseline text = "chi_adm_memorials_compact_autonomy" }
