				building_investment_explicit_item = {
					visible = "[EqualTo_int32(PdxGuiWidget.AccessParent.GetIndexInDataModel, '(int32)46')]" 
					datacontext = "[GetBuildingType('building_railway')]" 
				}
				}
			}
		}
	}
}
template article_input_items {
	margin_bottom = 10
	datacontext = "[ArticleDraft.GetArticleType]"

	### STATE LIST
	article_input_state_list = {
		visible = "[ArticleDraft.RequiresInput('state')]"
		datamodel = "[ArticleDraft.GetValidStates]"
	}

	### COUNTRY LIST
	article_input_country_list = {
		visible = "[ArticleDraft.RequiresInput('country')]"
		datamodel = "[ArticleDraft.GetValidCountries]"
	}

	### STRATEGIC REGION LIST
	article_input_strategic_region_list = {
		visible = "[ArticleDraft.RequiresInput('strategic_region')]"
		datamodel = "[ArticleDraft.GetValidStrategicRegions]"
	}

	### GOODS LIST
	article_input_goods_list = {
		visible = "[ArticleDraft.RequiresInput('goods')]"
		datamodel = "[ArticleDraft.GetValidGoods]"
	}

	### GOODS LIST - EMPTY STATE
	empty_state = {
		blockoverride "visible" {
			visible = "[And(IsDataModelEmpty(ArticleDraft.GetValidGoods), ArticleDraft.RequiresInput('goods'))]"
		}

		blockoverride "text" {
			text = "NONE"
		}

		blockoverride "size" {
			minimumsize = { 400 -1 }
			maximumsize = { 400 -1 }
		}
	}

	### COMPANY MONOPOLY
	article_input_company_monopoly = {
		visible = "[ArticleDraft.HasType('acquire_monopoly_for_company')]"
	}

	### BUILDING INVESTMENT RIGHTS
	article_input_building_investment = {
		visible = "[ArticleDraft.HasType('building_investment_rights')]"
	}

	### LAW LIST
	article_input_law_list = {
		visible = "[ArticleDraft.HasType('law_commitment')]"
	}

	### SHIP LIST
	article_input_ship_list = {
		visible = "[ArticleDraft.RequiresInput('ship')]"
	}
}

# Framed prose card: separate title band and body.
widget = {
    name = "chi_legation_rules"
    parentanchor = hcenter
    size = { 460 220 }
    background = {
        using = paper_bg_light
    }
    textbox = {
        position = { 18 14 }
        size = { 424 36 }
        fontsize = 24
        align = hcenter|nobaseline
        text = "chi_legation_rules_title"
    }
    divider_clean = {
        position = { 30 60 }
        size = { 400 2 }
    }
    textbox = {
        position = { 18 80 }
        size = { 424 120 }
        fontsize = 18
        text = "chi_legation_rules_summary"
    }
}
