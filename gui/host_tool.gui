	container = {
		position = { 356 96 }
		size = { 1050 700 }
		background = {
			alpha = 0.22
			using = entry_bg_fancy_dark
		}

		flowcontainer = {
			direction = vertical
			spacing = 14
			margin = { 20 18 }

			textbox = {
				size = { 1000 40 }
				using = fontsize_large
				text = "host_tool_panel_hint"
				align = left|nobaseline
				background = {
					alpha = 0.25
					using = fade_right_simple
					margin_left = 6
					margin_right = 24
				}
			}

			flowcontainer = {
				visible = "[GetVariableSystem.Exists('host_tool_tab_transfer_host')]"
				direction = vertical
				spacing = 10

				host_tool_section_title = { blockoverride "title_text" { text = "host_tool_transfer_host_title" } }
				host_tool_section_desc = { blockoverride "desc_text" { text = "host_tool_transfer_host_desc" } }

