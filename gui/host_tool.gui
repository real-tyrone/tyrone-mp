													blockoverride "country_onclick" {
														onclick = "[GetScriptedGui('host_tool_select_truce_country_b').Execute(GuiScope.SetRoot(GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope).AddScope('target', Country.MakeScope).End)]"
													}
													blockoverride "country_down" {
														down = "[ObjectsEqual(Country.MakeScope, GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_b').GetCountry.MakeScope)]"
													}
												}
											}
										}
