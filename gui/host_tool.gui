							flowcontainer = {
								direction = vertical
								spacing = 8
								margin = { 12 12 }
								host_tool_column_label = { blockoverride "label_text" { text = "host_tool_truce_first_country" } }
								scrollarea = {
									size = { 296 430 }
									scrollbarpolicy_horizontal = always_off
									scrollbar_vertical = { using = vertical_scrollbar }
									scrollwidget = {
										dynamicgridbox = {
											datamodel = "[GetGlobalList('host_tool_countries')]"
											datamodel_wrap = 1
											flipdirection = yes
											minimumsize = { 292 900 }
											item = {
												host_tool_country_row = {
													datacontext = "[Scope.GetCountry]"
													blockoverride "country_onclick" {
														onclick = "[GetScriptedGui('host_tool_select_truce_country_a').Execute(GuiScope.SetRoot(GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope).AddScope('target', Country.MakeScope).End)]"
													}
													blockoverride "country_down" {
														down = "[ObjectsEqual(Country.MakeScope, GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_a').GetCountry.MakeScope)]"
													}
												}
											}
										}
									}
								}
							}
						}
					}

					container = {
						size = { 330 510 }
						background = {
							alpha = 0.35
							using = entry_bg_fancy_dark
						}

						flowcontainer = {
							direction = vertical
							spacing = 14
							margin = { 16 16 }

							host_tool_column_label = { blockoverride "label_text" { text = "host_tool_confirm_remove_truce_button" } }

							textbox = {
								visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_a').IsSet]"
								size = { 296 32 }
								raw_text = "A: #v [GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_a').GetCountry.GetName]#!"
								using = fontsize_medium
								align = left|nobaseline
								elide = right
							}

							textbox = {
								visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_b').IsSet]"
								size = { 296 32 }
								raw_text = "B: #v [GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_b').GetCountry.GetName]#!"
								using = fontsize_medium
								align = left|nobaseline
								elide = right
							}

							host_tool_confirm_button = {
								visible = "[And(GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_a').IsSet, GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_b').IsSet)]"
								blockoverride "confirm_text" { text = "host_tool_confirm_remove_truce_button" }
