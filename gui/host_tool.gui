									enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope).AddScope('target_a', GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_a').GetCountry.MakeScope).AddScope('target_b', GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_b').GetCountry.MakeScope).End)]"
									tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope).AddScope('target_a', GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_a').GetCountry.MakeScope).AddScope('target_b', GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_b').GetCountry.MakeScope).End)]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope).AddScope('target_a', GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_a').GetCountry.MakeScope).AddScope('target_b', GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope.Var('host_tool_selected_truce_country_b').GetCountry.MakeScope).End)]"
								}
							}
						}
					}

