@tyrone_great_game_widget_width = 420

widget = {
	name = "tyrone_great_game_journal_open_widget"
	size = { @tyrone_great_game_widget_width 130 }
	layoutpolicy_horizontal = expanding

	background = {
		using = default_background
		alpha = 0.18
	}

	vbox = {
		margin = { 12 10 }
		spacing = 8
		layoutpolicy_horizontal = expanding

		textbox = {
			layoutpolicy_horizontal = expanding
			size = { 100% 26 }
			text = "tyrone_great_game_journal_header"
			using = fontsize_large
		}

		textbox = {
			layoutpolicy_horizontal = expanding
			size = { 100% 42 }
			text = "tyrone_great_game_journal_summary"
			using = fontsize_small
			autoresize = yes
		}

		button = {
			using = default_button
			size = { 220 34 }
			text = "tyrone_great_game_open_map_button"
			tooltip = "tyrone_great_game_open_map_button_tt"
			onclick = "[GetVariableSystem.Set('tyrone_great_game_gui_open', 'true')]"
		}
	}
}
