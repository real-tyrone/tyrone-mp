# COPY-PASTED FOR NOW
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520			
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

types berlin_conference_types {
	type claimed_countries_gui = flowcontainer {
        block "context" {}
		direction = vertical
        using = default_list_position
        spacing = 10
        margin_bottom = 28

		default_header_clean = {
            using = default_list_position
            # At least one side needs to have factions for them to show up
            blockoverride "text" {
                raw_text = "The Claims of the Great Powers"
            }
            blockoverride "size" {
                size = { @panel_width_plus_14 44 }
            }
        }
        flowcontainer = {
            spacing = 8

            left_side_claims = {}

            right_side_claims = {}
        }
	}

	type left_side_claims = flowcontainer {
        direction = vertical
        spacing = 20
        margin_left = 12
		
		#congo
        flowcontainer = {
            margin_top = -2
            background = {
                using = simple_frame
            }

            default_header_clean_faded = {
                blockoverride "text" {
                    text = "Congo"
                }
            }

            blockoverride "size" {
                size = { @[panel_width_half - 20] 45 }
            }
            
            direction = vertical

            dynamicgridbox = {
                parentanchor = hcenter
                datamodel = "[GetGlobalList('congo_claimed_countries_list')]"
                datamodel_wrap = 3
                flipdirection = yes

                item = {
                    flowcontainer = {
                        visible = "[Scope.GetCountry.IsValid]"
                        margin = { 5 10 }
                        minimumsize = { 27 18 }
                        small_flag = {
                            datacontext = "[Scope.GetCountry]"
                        }
                    }
                }
            }
        }
        

		#senegal
        flowcontainer = {
            margin_top = -2
            background = {
                using = simple_frame
            }

            default_header_clean_faded = {
                blockoverride "text" {
                    text = "Senegal"
                }
            }

            blockoverride "size" {
                size = { @[panel_width_half - 20] 45 }
            }
            
            direction = vertical

            dynamicgridbox = {
                parentanchor = hcenter
                datamodel = "[GetGlobalList('senegal_claimed_countries_list')]"
                datamodel_wrap = 3
                flipdirection = yes

                item = {
                    flowcontainer = {
                        visible = "[Scope.GetCountry.IsValid]"
                        margin = { 5 10 }
                        minimumsize = { 27 18 }
                        small_flag = {
                            datacontext = "[Scope.GetCountry]"
                        }
                    }
                }
            }
        }
        

		#niger
        flowcontainer = {
                margin_top = -2
                background = {
                    using = simple_frame
                }

                default_header_clean_faded = {
					blockoverride "text" {
						text = "Niger"
					}
				}

                blockoverride "size" {
                    size = { @[panel_width_half - 20] 45 }
                }
                
                direction = vertical

            dynamicgridbox = {
                parentanchor = hcenter
                datamodel = "[GetGlobalList('niger_claimed_countries_list')]"
                datamodel_wrap = 3
                flipdirection = yes

                item = {
                    flowcontainer = {
                        visible = "[Scope.GetCountry.IsValid]"
                        margin = { 5 10 }
                        minimumsize = { 27 18 }
                        small_flag = {
                            datacontext = "[Scope.GetCountry]"
                        }
                    }
                }
            }
        }
        
    }

	type right_side_claims = flowcontainer {
        direction = vertical
        spacing = 20
        margin_left = 12

		#ethiopia	
        flowcontainer = {
            margin_top = -2
            background = {
                using = simple_frame
            }

            default_header_clean_faded = {
                blockoverride "text" {
                    text = "Ethiopia"
                }
            }

            blockoverride "size" {
                size = { @[panel_width_half - 20] 45 }
            }
            
            direction = vertical

            dynamicgridbox = {
                parentanchor = hcenter
                datamodel = "[GetGlobalList('ethiopia_claimed_countries_list')]"
                datamodel_wrap = 3
                flipdirection = yes

                item = {
                    flowcontainer = {
                        visible = "[Scope.GetCountry.IsValid]"
                        margin = { 5 10 }
                        minimumsize = { 27 18 }
                        small_flag = {
                            datacontext = "[Scope.GetCountry]"
                        }
                    }
                }
            }
        }
        

		#zanj
        flowcontainer = {
            margin_top = -2
            background = {
                using = simple_frame
            }

            default_header_clean_faded = {
                blockoverride "text" {
                    text = "Zanj"
                }
            }

            blockoverride "size" {
                size = { @[panel_width_half - 20] 45 }
            }
            
            direction = vertical

            dynamicgridbox = {
                parentanchor = hcenter
                datamodel = "[GetGlobalList('zanj_claimed_countries_list')]"
                datamodel_wrap = 3
                flipdirection = yes

                item = {
                    flowcontainer = {
                        visible = "[Scope.GetCountry.IsValid]"
                        margin = { 5 10 }
                        minimumsize = { 27 18 }
                        small_flag = {
                            datacontext = "[Scope.GetCountry]"
                        }
                    }
                }
            }
        }
        

		#south africa
        flowcontainer = {
            margin_top = -2
            background = {
                using = simple_frame
            }

            default_header_clean_faded = {
                blockoverride "text" {
                    text = "South Africa"
                }
            }

            blockoverride "size" {
                size = { @[panel_width_half - 20] 45 }
            }
            
            direction = vertical

            dynamicgridbox = {
                parentanchor = hcenter
                datamodel = "[GetGlobalList('saf_claimed_countries_list')]"
                datamodel_wrap = 3
                flipdirection = yes

                item = {
                    flowcontainer = {
                        visible = "[Scope.GetCountry.IsValid]"
                        margin = { 5 10 }
                        minimumsize = { 27 18 }
                        small_flag = {
                            datacontext = "[Scope.GetCountry]"
                        }
                    }
                }
            }
        }
        
    }
}