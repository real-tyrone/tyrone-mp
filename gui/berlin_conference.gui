	type berlin_conf_journal_button = container {
		parentanchor = hcenter
		visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_berlin_conference'))]"
		minimumsize = { @panel_width_minus_30 -1 }

		background = {
			alpha = 0.4
			using = entry_bg_fancy_dark
		}

	}

	type claimed_countries_gui = container {
        visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_berlin_conference'))]"
        parentanchor = hcenter

        flowcontainer = {
			parentanchor = hcenter
			direction = vertical
			spacing = 10
			margin = { 10 10 }

			button = {
				using = default_button
				parentanchor = hcenter
				size = { @panel_width_minus_30 50 }
				using = fontsize_large
				raw_text = "Open the #gold Berlin Conference#! view."
				tooltip = "berlin_conf_open_button_tt"
				onclick = "[GetVariableSystem.Set('berlin_conf_open', 'true')]"
				onclick = "[GetVariableSystem.Set('berlin_tab_east', 'true')]"
				onclick = "[GetVariableSystem.Clear('berlin_tab_subsaharan')]"
				onclick = "[GetVariableSystem.Clear('berlin_tab_congo')]"
				onclick = "[GetVariableSystem.Clear('berlin_tab_south')]"
			}
		}


    }

	type berlin_area_tab = widget {
		size = { 160 80 }
		block "tab_position" { parentanchor = hcenter  position = { 0 0 } }

		button = {
			size = { 90% 40% }
			using = default_button_primary
			enabled = no
			block "tab_text" { raw_text = "" }
			using = fontsize_medium
			block "tab_active_visible" { visible = no }
		}

		button = {
			size = { 90% 40% }
			using = default_button
			block "tab_text" { raw_text = "" }
			using = fontsize_medium
			block "tab_inactive_visible" { visible = yes }
			block "tab_onclick" {}
		}
	}

}


# Transparent map hitboxes reuse the same claim actions as the side controls.
types tyr_berlin_map_hit_types {
	type tyr_berlin_map_hit_west_africa = button {
		using = select_button_sound
		texture = "gfx/interface/buttons/default_button_bg.dds"
		gfxtype = togglepushbuttongfx
		effectname = "NoHighlight"
		downpressedframe = 1
		disableframe = 3
		alpha = 0
		tooltip = "[GetScriptedGui('berlin_conf_claim_west_africa').BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
		onclick = "[GetScriptedGui('berlin_conf_claim_west_africa').Execute( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
	}
