	textbox = {
			parentanchor = right
			align = hcenter
			position = { -190 -70 }
			using = fontsize_large
			fontsize_min = 30
			raw_text = "#Gold #bold Rules of the Berlin Conference#!#!"
			margin_top = 260
			textbox = {
				position = { -190 40 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "- #yellow Nations#! are given claims based on #gold Great#!"
				margin_top = 260
			}
			textbox = {
				position = { -191 60 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "   #gold Power#! Rank. No further claims are given."
				margin_top = 260
			}

			textbox = {
				position = { -190 90 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "- One #gold Area#! can only be claimed by 3 #yellow nations#!"
				margin_top = 260
			}
			textbox = {
				position = { -191 110 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "   at once."
				margin_top = 260
			}

			textbox = {
				position = { -190 140 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "- At the end of the #gold Conference#! claims on the"
				margin_top = 260
			}
			textbox = {
				position = { -191 160 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "  #gold African regions#! will be given."
				margin_top = 260
			}
			textbox = {
				position = { -190 190 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "- #red Great Powers 1 to 3 can lock areas based on"
				margin_top = 260
			}
			textbox = {
				position = { -191 210 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "   #red rank.#! Locked areas can be claimes only by"
				margin_top = 260
			}
			textbox = {
				position = { -191 230 }
				using = fontsize_large
				fontsize_min = 30
				raw_text = "   other #gold Great Powers#! with rank #bold 1 to 3#!."
				margin_top = 260
			}
			textbox = {
				position = { -190 248 }
				using = fontsize_small
				fontsize_min = 30
				raw_text = "    #yellow (Locks aren't recoverable, they're removed once used.)"
				margin_top = 260
			}
			

		}

	berlin_area_tab = {
		blockoverride "tab_position" { parentanchor = center  position = { -550 -320 } }
		blockoverride "tab_text" { raw_text = "Sub-Saharan Africa" }
		blockoverride "tab_active_visible" {
			visible = "[GetVariableSystem.Exists('berlin_tab_subsaharan')]"
