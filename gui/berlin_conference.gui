	flowcontainer = {
		name = "top3_gp_panel"
		position = { 640 320 }
		parentanchor = hcenter
		alwaystransparent = yes
		direction = vertical
		spacing = 5

		default_header_clean = {
			using = default_list_position
			blockoverride "text" { raw_text = "Top Great Powers" }
			blockoverride "size" { size = { 380 44 } }
		}

		
		
		flowcontainer = {
			margin_top = -2
			parentanchor = hcenter
			direction = vertical
			dynamicgridbox = {
				parentanchor = hcenter
				datamodel = "[GetGlobalList('berlin_conf_top3_gp_list')]"
				datamodel_wrap = 3
				flipdirection = yes
				minimumsize = { 0 60 }
				item = {
					flowcontainer = {
						visible = "[Scope.GetCountry.IsValid]"
						tooltip = "[Scope.GetCountry.GetName]"
						margin = { 20 15 }
						minimumsize = { 27 18 }
						small_flag = { datacontext = "[Scope.GetCountry]" }
					}
				}
			}
		}
	}
	icon = {
			parentanchor = left|vcenter
			texture = "gfx/interface/gui_elements/africaDivider2.dds"
			size = { 370 200 }
			position = { 1300 -30 }
			}
	icon = {
			parentanchor = left|vcenter
			texture = "gfx/interface/gui_elements/africaDivider.dds"
			size = { 370 200 }
			position = { 1300 200 }
			
			}
	

	flowcontainer = {
		name = "involved_countries_panel"
		position = { 640 715 }
		parentanchor = hcenter
		alwaystransparent = yes
		direction = vertical
		spacing = 5

		default_header_clean = {
			using = default_list_position
			blockoverride "text" { raw_text = "Involved Countries" }
			blockoverride "size" { size = { 380 44 } }
		}
		flowcontainer = {
			margin_top = -2
			parentanchor = hcenter
			background = { using = entry_bg_fancy_dark }
			button = {
				using = default_button
				size = { 370 25 }
				text = "conference_members_label"
				enabled = no
			}
			direction = vertical
			dynamicgridbox = {
				parentanchor = hcenter
				datamodel = "[GetGlobalList('part_of_berlin_conf_list')]"
				datamodel_wrap = 6
				flipdirection = yes
				minimumsize = { 0 140 }
				item = {
					flowcontainer = {
						visible = "[Scope.GetCountry.IsValid]"
						tooltip = "[Scope.GetCountry.GetName]"
						margin = { 5 15 }
						minimumsize = { 27 18 }
						small_flag = { datacontext = "[Scope.GetCountry]" }
					}
				}
			}
		}
	}
}
