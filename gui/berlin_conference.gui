@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530
@panel_width = 540
@panel_width_half = 270
@panel_width_plus_10 = 550
@panel_width_plus_14 = 554
@panel_width_plus_14_half = 277
@panel_width_plus_20 = 560
@panel_width_plus_30 = 570
@panel_width_plus_70 = 610

types berlin_conference_types {
	type claimed_countries_gui = container {
        visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_berlin_conference'))]"
        minimumsize = { 540 400 }
        maximumsize = { 540 -1 }
        parentanchor = hcenter


        flowcontainer = {
            direction = vertical
            margin_left = 20
            parentanchor = top|center
            spacing = 120
            default_header_clean = {
                using = default_list_position
                blockoverride "text" {
                    text = "#white Claims of the Great Powers#!"
                }
                blockoverride "size" {
                    size = { @panel_width_plus_70 60 }
                }
                background = { using = simple_frame }
            }
        }
        flowcontainer = {
            name = "start_scramble_decision_content"
            minimumsize = { 500 400 }
            maximumsize = { 500 -1 }
            parentanchor = center
            margin = { 20 20 }
            direction = vertical
            spacing = 0

            widget = { size = { 30 30 } }

            flowcontainer = {
                name = "Sub-Saharan"
                margin_top = 20
                direction = vertical
                spacing = 20
                using = default_list_position

                default_header_clean = {
                    using = default_list_position
                    blockoverride "text" { raw_text = "Sub-Saharan" }
                    blockoverride "size" { size = { @[panel_width - 10] 44 } }
                }

                flowcontainer = {
                    direction = horizontal
                    spacing = 10
                    margin_top = 10

                    flowcontainer = {
                        direction = vertical
                        spacing = 20
                        minimumsize = { @[panel_width_half - 10] -1 }

                        flowcontainer = {
                            margin_top = -2
                            parentanchor = hcenter
                            background = { using = simple_frame }
                            button = {
                                name = "berlin_claim_btn_west_africa"
                                using = default_button_primary_action
                                size = { @[panel_width_half - 25] 45 }
                                text = "West Africa"
                                datacontext = "[GetScriptedGui('berlin_conf_claim_west_africa')]"
                                visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_berlin_conference'))]"
                                enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
                                tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
                                onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
                            }
                            direction = vertical
                            dynamicgridbox = {
                                parentanchor = hcenter
                                datamodel = "[GetGlobalList('west_africa_claimed_countries_list')]"
                                datamodel_wrap = 3
                                flipdirection = yes
                                item = {
                                    flowcontainer = {
                                        visible = "[Scope.GetCountry.IsValid]"
                                        margin = { 5 20 }
                                        minimumsize = { 27 18 }
                                        small_flag = { datacontext = "[Scope.GetCountry]" }
                                    }
                                }
                            }
                        }
                        flowcontainer = {
                            margin_top = -2
                            parentanchor = hcenter
                            background = { using = simple_frame }
                            button = {
                                name = "berlin_claim_btn_chad"
