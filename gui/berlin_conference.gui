types berlin_conference_types {

	# Read-only JE preview. Same live claimant lists and colors as the full map.
	# Full-map art is scaled to 75% and cropped to the African continent.
	type tyr_berlin_entry_claim_map = widget {
		name = "tyr_berlin_entry_claim_map"
		parentanchor = hcenter
		size = { @panel_width_minus_30 580 }
		scissor = yes
		alwaystransparent = yes
		background = { using = paper_bg_dark }
		icon = {
			alwaystransparent = yes
			texture = "gfx/interface/gui_elements/uncolonizable.dds"
			position = { -1103 -364 }
			size = { 2475 1238 }
		}
		icon = {
			alwaystransparent = yes
			texture = "gfx/interface/gui_elements/westAfrica.dds"
			position = { -1103 -364 }
			size = { 2475 1238 }
			visible = "[EqualTo_int32(GetDataModelSize(GetGlobalList('west_africa_claimed_countries_list')), '(int32)0')]"
		}
		dynamicgridbox = {
			alwaystransparent = yes
			position = { -1103 -364 }
			datamodel = "[GetGlobalList('west_africa_claimed_countries_list')]"
			visible = "[EqualTo_int32(GetDataModelSize(GetGlobalList('west_africa_claimed_countries_list')), '(int32)1')]"
			item = {
				widget = {
					alwaystransparent = yes
					size = { 2475 1238 }
					datacontext = "[Scope.GetCountry]"
					visible = "[Scope.GetCountry.IsValid]"
					icon = { alwaystransparent = yes texture = "gfx/interface/gui_elements/westAfrica.dds" size = { 2475 1238 } color = "[Country.GetMapColor]" }
					icon = { alwaystransparent = yes texture = "gfx/interface/gui_elements/westAfrica.dds" size = { 2475 1238 } color = "[Country.GetMapColor]" alpha = 0.55 }
					icon = { alwaystransparent = yes texture = "gfx/interface/gui_elements/westAfrica.dds" size = { 2475 1238 } color = { 1 1 1 0.25 } }
