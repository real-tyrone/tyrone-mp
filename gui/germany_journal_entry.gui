@panel_width_minus_20 = 520
@panel_width_plus_20 = 560

types journal_entry_panel_types {
	type bismarck_reform_gui = flowcontainer {
		direction = vertical
		parentanchor = center
		visible = "[EqualTo_string(JournalEntry.GetName, Localize('je_bismarck_reform'))]"

		# Layout: left = Bismarck portrait, right = empty placeholder for future containers.
		flowcontainer = {
			direction = horizontal
			spacing = 0
			parentanchor = hcenter
			margin_top = -25
			margin_bottom = -10

			
			
			widget = {
				size = { 520 440 }
				container = {
					datacontext = "[JournalEntry.GetCountry.GetInterestGroupOfType('ig_landowners').GetLeader]"
					parentanchor = center
					flowcontainer = {
						background = {
							using = entry_bg
						}
						direction = vertical
						character_portrait_base = {
								size = { 320 350 }

								parentanchor = hcenter
								blockoverride "show_hat" {
									scissor = yes
								}
								blockoverride "portrait_texture" {
									portrait_texture = "[Character.GetAnimatedPortrait('environment_standard_V1', 'camera_event_right', 'idle', GetPortraitRenderSize(PdxGuiWidget.Self))]"
								}
								blockoverride "portrait_size" {
									size = { 320 390 }
								}
								blockoverride "portrait_position" {
									position = { 0 -18 }
								}
								blockoverride "portrait_frame" {
									icon = {
										texture = "gfx/interface/portraits/portrait_frame_torso_historical_no_info_link.dds"
										size = { 100% 330 }
										position = { 0 3 }
										parentanchor = bottom|hcenter
										using = naval_commander_color
									}
								}
								
								blockoverride "portrait_icons" {}
								blockoverride "highlight" {}
							}
						default_header_clean_faded = {
							size = { 250 60 }
							blockoverride "text" {}
							parentanchor = hcenter
							margin = { 10 10 }
							textbox = {
								text = "Otto von Bismarck"
								parentanchor = vcenter|hcenter
								position = { 0 -3 }
								autoresize = yes
								max_width = 256
								using = fontsize_large
							}
							
						}
					}
				}
				
			}


			


		}

	
}
}
