types host_tool_journal_widgets {
	type host_tool_open_widget = container {
		parentanchor = hcenter
		minimumsize = { 520 60 }

		background = {
			alpha = 0.4
			using = entry_bg_fancy_dark
		}

		flowcontainer = {
			parentanchor = hcenter
			direction = vertical
			spacing = 8
			margin = { 10 10 }

			button = {
				using = default_button
				parentanchor = hcenter
				size = { 500 46 }
				using = fontsize_large
				text = "host_tool_open_button"
				tooltip = "host_tool_open_button_tt"
				onclick = "[GetVariableSystem.Set('host_tool_open', 'true')]"
				onclick = "[GetVariableSystem.Set('host_tool_tab_transfer_host', 'true')]"
				onclick = "[GetVariableSystem.Clear('host_tool_tab_money')]"
				onclick = "[GetVariableSystem.Clear('host_tool_tab_states')]"
				onclick = "[GetVariableSystem.Clear('host_tool_tab_release_subject')]"
				onclick = "[GetVariableSystem.Clear('host_tool_tab_make_subject')]"
				onclick = "[GetVariableSystem.Clear('host_tool_tab_wars')]"
				onclick = "[GetScriptedGui('host_tool_refresh_gui_lists').Execute(GuiScope.SetRoot(GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope).End)]"
			}
		}
	}
}
